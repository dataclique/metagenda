{
  "name": "metagenda",
  "version": "0.1.0",
  "bin": "dist/index.js",
  "main": "dist/index.js",
  "types": "dist/*/**.d.ts",
  "scripts": {
    "dev": "bun src/index.ts",
    "build": "tsc -P tsconfig.json",
    "build:watch": "tsc -P tsconfig.json -w",
    "typecheck": "tsc -P tsconfig.json --noEmit",
    "test": "vitest run cli/test --config ../vitest.config.ts",
    "test:watch": "vitest cli/test --config ../vitest.config.ts --typecheck --watch",
    "lint": "eslint -c eslint.config.mjs . --max-warnings=0",
    "lint:fix": "eslint -c eslint.config.mjs . --fix",
    "verify": "bun run typecheck && bun run lint && bun run test && bun run build"
  },
  "devDependencies": {
    "@effect/eslint-plugin": "^0.3.2",
    "@effect/vitest": "^0.30.0",
    "@eslint/js": "^10.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.10.0",
    "prettier": "3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "dependencies": {
    "@effect/cli": "^0.77.1",
    "@effect/cluster": "^0.60.2",
    "@effect/experimental": "^0.61.1",
    "@effect/opentelemetry": "^0.64.1",
    "@effect/platform": "^0.97.2",
    "@effect/platform-node": "^0.108.2",
    "@effect/printer": "^0.51.0",
    "@effect/printer-ansi": "^0.51.0",
    "@effect/rpc": "^0.76.2",
    "@effect/sql": "^0.52.1",
    "@effect/typeclass": "^0.41.0",
    "@effect/workflow": "^0.19.1",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@opentelemetry/sdk-trace-web": "^2.11.0",
    "effect": "3.22.2",
    "yaml": "^2.9.1"
  }
}
